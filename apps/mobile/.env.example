# Same Supabase project as apps/web — copy the real values from
# apps/web/.env.local (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Must be your dev machine's LAN IP, not localhost — a physical phone
# running this app in Expo Go can't resolve "localhost" to your computer.
# Find it with `ipconfig getifaddr en0` (macOS) and keep the port apps/api
# actually listens on (see apps/api/.env's PORT, default 8080).
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Standalone CardVision service (apps/cardvision) — separate app/DB/API
# from the marketplace backend above. Same LAN-IP requirement as above;
# see apps/cardvision/.env's PORT (default 8090).
EXPO_PUBLIC_CARDVISION_URL=http://192.168.1.100:8090

# Dev-only test accounts (see src/lib/dev-accounts.ts) — mirrors
# apps/web/.env.local's DEV_ACCOUNT_* values, same real Supabase project.
# Optional: the quick-switch panel just doesn't render without these.
EXPO_PUBLIC_DEV_ACCOUNT_SELLER_EMAIL=
EXPO_PUBLIC_DEV_ACCOUNT_SELLER_PASSWORD=
EXPO_PUBLIC_DEV_ACCOUNT_BIDDER_A_EMAIL=
EXPO_PUBLIC_DEV_ACCOUNT_BIDDER_A_PASSWORD=
EXPO_PUBLIC_DEV_ACCOUNT_BIDDER_B_EMAIL=
EXPO_PUBLIC_DEV_ACCOUNT_BIDDER_B_PASSWORD=
