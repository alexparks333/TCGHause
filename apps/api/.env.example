# Copy this file to .env and fill in real values (apps/api/.env is
# git-ignored). cmd/api loads .env automatically via godotenv.

PORT=8080

# Defaults to "development" if unset — enables the 1/2/5-minute dev-only
# auction durations (CLAUDE.md §6.1) used to test the bidding engine without
# waiting days. Set APP_ENV=production to restrict auctions to the real
# 2-day/3.5-day/7-day durations only.
APP_ENV=development

# Project Settings -> Database -> Connection string -> "URI" (direct
# connection, not the pgbouncer/transaction-pooler one, since the Go API
# holds long-lived pgxpool connections). This uses the postgres role, which
# bypasses the RLS enabled in migration 0002 — that's intentional, see
# CLAUDE.md's auth section.
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Project Settings -> API -> Project URL. Used to fetch the JWKS at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json for verifying incoming
# request tokens. Not secret.
SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings -> API -> service_role secret key. WARNING: this is
# meaningfully more powerful than every other secret in this file — it
# bypasses Row Level Security for the ENTIRE Supabase project, not just one
# table or bucket. Used exactly once today, in internal/photosession, to
# upload a phone-camera photo to Storage on behalf of a session whose phone
# client is deliberately never logged in (so it can't satisfy the normal
# auth.uid()-based RLS policy the browser upload path relies on). Never
# expose this to the frontend. Leave unset to skip registering
# POST /photo-sessions/{id}/photos — the Sell wizard's QR "upload from your
# phone" panel just won't work, everything else is unaffected.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-keep-this-secret>

# Upstash: Redis dashboard -> REST/connection details.
REDIS_URL=redis://default:<password>@<endpoint>.upstash.io:6379

# TEST-mode secret key (sk_test_...) from the Stripe dashboard
# (dashboard.stripe.com/test/apikeys) — powers the Buy It Now checkout
# flow (internal/payment). Free, unlimited, and doesn't touch real money;
# no business verification required to get test keys, only to later
# switch to live ones. Leave unset to fall back to Buy It Now's original
# no-payment mock path — the app still works fully without this.
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>

# Signing secret for /webhooks/stripe (internal/webhook) — verifies incoming
# webhook requests actually came from Stripe. For local dev, run
# `stripe listen --forward-to localhost:8080/webhooks/stripe` (Stripe CLI)
# and it will print a whsec_... value for this. Leave unset to skip
# registering the webhook route — Connect onboarding status and payment
# confirmations then only update via API calls made directly by handlers.
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>

# Shared HMAC secret for /webhooks/carrier (internal/shipping) — a
# carrier-agnostic stand-in for a real carrier delivery-tracking webhook
# (see that file's doc comment: EasyPost's own tracker-webhook signature
# scheme isn't wired up yet, only label PURCHASE is real so far). Any
# random string works for local testing. Leave unset to skip registering
# the route entirely.
CARRIER_WEBHOOK_SECRET=<any-random-string-for-local-dev>

# Shippo API token (app.goshippo.com -> Settings -> API) — powers real
# shipping-label purchase (internal/shipping.Client,
# docs/Shipping_Research.md). Shippo, not EasyPost: EasyPost's account-
# verification wall never cleared despite repeated support contact, see
# internal/shipping's package doc. A Test token (shippo_test_...) works for
# local dev — free, doesn't touch real postage cost. Leave unset to skip
# registering POST /listings/{id}/order/shipping-label.
SHIPPO_API_TOKEN=<your-shippo-test-token>

# Pitney Bowes Shipping 360 sandbox credentials (developer hub for the
# api-sandbox.sendpro360.pitneybowes.com platform — a different, newer
# Pitney Bowes API than the legacy shipping-api-sandbox.pitneybowes.com
# one, confirmed live to be what these Client ID/Secret pairs actually
# authenticate against) — powers real tracked-envelope label purchase
# (internal/shipping.PitneyBowesClient) in test mode, no real postage
# cost. Free self-serve developer sandbox, no sales call/credit card.
# No Shipper ID needed — confirmed directly with Pitney Bowes support
# that it's a legacy-API concept this platform doesn't use; the carrier
# account these credentials should use is looked up automatically via
# GET /shipping/api/v1/carrierAccounts, not configured here. Leave either
# of the two below unset to skip registering the tracked_envelope side of
# label purchase.
PITNEY_BOWES_CLIENT_ID=<your-pitney-bowes-sandbox-client-id>
PITNEY_BOWES_CLIENT_SECRET=<your-pitney-bowes-sandbox-client-secret>

# Google Cloud API key with "Places API (New)" enabled (Google Cloud
# Console -> APIs & Services -> Library -> enable it, then Credentials ->
# Create API key; restrict it to Places API only). Powers real address
# autocomplete/suggestions (internal/address.AutocompleteClient) on the
# checkout shipping-address step and Account Settings' shipping address —
# added specifically to cut down on the free-text address typos that pass
# a human eye test but fail Pitney Bowes' stricter USPS-backed validation.
# Server-side only, never sent to the browser (this key is billable, same
# reasoning as every other third-party credential in this file). Leave
# unset to skip registering GET /address/autocomplete{,/resolve} — the
# frontend falls back to a plain text field with no suggestions.
GOOGLE_PLACES_API_KEY=<your-google-cloud-places-api-key>

# Comma-separated email allowlist gating the claims human-review endpoints
# (internal/dispute) — a minimal stand-in for a real admin app, which
# doesn't exist in this repo yet. Empty means nobody can reach those routes.
ADMIN_EMAILS=you@example.com

# TCG Haven's Firebase/GCP project ID — internal/cardcatalog reads its
# Firestore card catalog (read-only) to power the Sell wizard's
# "search for your card" autofill (GET /catalog/search). Leave unset to
# skip registering that route; the Sell wizard's fields stay hand-typed.
CARD_CATALOG_PROJECT_ID=tcghaven-85a34

# Path to a service account JSON key scoped to roles/datastore.viewer on
# CARD_CATALOG_PROJECT_ID (IAM & Admin -> Service Accounts -> create one,
# grant it Cloud Datastore Viewer, then Keys -> Add Key -> JSON). Use a
# dedicated read-only account here, never TCG Haven's own write-capable
# "sync" account (download-card-catalog.mjs's ADMIN_EMAIL/ADMIN_PASSWORD) —
# Firestore IAM roles aren't collection-scoped, so this key can technically
# read any collection in that project, not just the catalog (see
# internal/cardcatalog's package doc). Keep the key file itself out of
# version control regardless of where you put it.
CARD_CATALOG_CREDENTIALS_FILE=./secrets/tcghaven-catalog-reader.json

# Resend API key (resend.com/api-keys) — powers internal/mail, the one real
# email this repo sends: alerting support@ when a claim escalates to
# human_review (internal/dispute.Escalate/notifyHumanReview). Before this
# works, verify auctionhous.net as a sending domain in the Resend dashboard
# (Domains -> Add Domain) and add the DNS records it gives you at your
# registrar. IMPORTANT: auctionhous.net's DNS almost certainly already has
# an SPF TXT record from Microsoft 365 (the real support@ mailbox) — merge
# Resend's SPF include into that SAME record rather than adding a second
# one; multiple SPF TXT records on one domain silently break, they don't
# combine. Leave unset to skip sending this email entirely — claims still
# work fully without it, human_review just isn't emailed anywhere yet.
RESEND_API_KEY=re_<your-resend-api-key>

# From/To for the email above. From does NOT need its own real mailbox
# (it's just the message's From header) but its domain must be the one you
# verified with Resend. To should be the real support mailbox — override it
# in local dev (e.g. to your own address) so testing this doesn't actually
# page support@.
CLAIMS_NOTIFY_FROM_EMAIL=AuctionHous Claims <claims@auctionhous.net>
CLAIMS_NOTIFY_TO_EMAIL=support@auctionhous.net
