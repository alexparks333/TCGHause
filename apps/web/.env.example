# Copy this file to .env.local and fill in real values.
# Find both in the Supabase dashboard: Project Settings -> API.
# Both of these are meant to be exposed to the browser (NEXT_PUBLIC_) —
# they are not secret. Do not put the service_role/secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# apps/api's base URL. Public/non-secret — this is a browser-facing API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# TEST-mode publishable key (pk_test_...) from the Stripe dashboard
# (dashboard.stripe.com/test/apikeys) — powers the Buy It Now checkout
# page's Stripe Elements form (lib/stripe.ts). Meant to be exposed to the
# browser, same as the Supabase keys above. Leave unset and the checkout
# page falls back to the original "Pay With PayPal (Mock)" button — see
# apps/api/.env.example's STRIPE_SECRET_KEY, which gates the matching
# backend behavior.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-test-publishable-key>

# Optional, dev-only: real Supabase accounts used by the "Quick Switch" panel
# (components/DevQuickSwitch.tsx) to sign in as a different test identity
# without the log-out/log-in dance, so you can actually test bidding across
# accounts. Deliberately NOT NEXT_PUBLIC_ — these never reach the browser,
# only the server-side route that performs a real sign-in with them. The
# panel only renders and the route only responds when NODE_ENV=development;
# both no-op in production regardless of whether these are set.
DEV_ACCOUNT_SELLER_EMAIL=
DEV_ACCOUNT_SELLER_PASSWORD=
DEV_ACCOUNT_BIDDER_A_EMAIL=
DEV_ACCOUNT_BIDDER_A_PASSWORD=
DEV_ACCOUNT_BIDDER_B_EMAIL=
DEV_ACCOUNT_BIDDER_B_PASSWORD=
