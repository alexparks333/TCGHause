# Local dev target: Homebrew-installed postgresql@16 + minio (no Docker in
# this environment — infra/docker-compose.yml documents the containerized
# target for later, same pattern apps/api already follows for its own
# Postgres/Redis/MinIO entries). Own dedicated database — never the
# marketplace's Supabase project.
DATABASE_URL=postgresql://localhost:5432/cardvision

# S3-compatible object storage. Local dev points at the Homebrew minio
# server; production points at real S3/R2/Supabase Storage.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cardvision
S3_SECRET_KEY=cardvision123
S3_BUCKET=cardvision-scans
S3_REGION=us-east-1

PORT=8090
